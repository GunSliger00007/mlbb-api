// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Hero {
  id          String      @id @default(uuid())
  name        String
  role        Role[]  @default([UNDEFINED])
  description String?
  image       String?
  releaseDate DateTime @default(now())
  skills      Skill[]
  skins       Skin[]
  attributes  HeroAttribute?

  @@map("heroes")
}

enum Role {
  ASSASSIN
  FIGHTER
  MAGE
  MARKSMAN
  SUPPORT
  TANK
  UNDEFINED
}

model Skill {
  id          String      @id @default(uuid())
  name        String
  description String?
  image       String?
  cooldown    Float
  heroId      String
  hero        Hero     @relation(fields: [heroId], references: [id])

  @@map("skills")
}

model Skin {
  id          String      @id @default(uuid())
  name        String
  releaseDate DateTime @default(now())
  image       String?
  heroId      String
  hero        Hero     @relation(fields: [heroId], references: [id])

  @@map("skins")
}

model HeroAttribute {
  id                String @id @default(uuid())
  heroId            String @unique
  hero              Hero   @relation(fields: [heroId], references: [id])

  hp                Float
  hpGrowth          Float?
  hpRegen           Float?
  mana              Float?
  manaGrowth        Float?
  manaRegen         Float?
  physicalAttack    Float?
  physicalAttackGrowth Float?
  magicPower        Float?
  physicalDefense   Float?
  magicDefense      Float?
  attackSpeed       Float?
  attackSpeedGrowth Float?
  movementSpeed     Float?
  attackRange       Float?

  @@map("hero_attributes")
}

model Item {
  id          String      @id @default(uuid())
  name        String
  description String?
  image       String?
  cost        Int
  cooldown    Float?

  @@map("items")
}

model Emblem {
  id              String      @id @default(uuid())
  name            String
  description     String?
  image           String?
  emblemTalents   EmblemTalent[]

  @@map("emblems")
}

model EmblemTalent {
  id          String      @id @default(uuid())
  name        String
  description String?
  image       String?
  emblemId    String
  emblem      Emblem   @relation(fields: [emblemId], references: [id])

  @@map("emblem_talents")
}

model Spell {
  id          String      @id @default(uuid())
  name        String
  description String?
  image       String?
  cooldown    Float

  @@map("spells")
}

model GameMode {
  id          String      @id @default(uuid())
  name        String
  description String?

  @@map("game_modes")
}

model Rank {
  id          String      @id @default(uuid())
  name        String
  description String?
  image       String?

  @@map("ranks")
}


// Tables
// Heroes, Skins, Items, Emblems, Spells, Game Modes,
// Ranks , Skills, Attributes, Attributes Types
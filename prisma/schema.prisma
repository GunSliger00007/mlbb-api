// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Hero {
  id          String      @id @default(uuid())
  name        String
  role        String
  description String
  image       String
  releaseDate DateTime @default(now())
  skins       Skin[]
}

model Skin {
  id          String      @id @default(uuid())
  name        String
  releaseDate DateTime @default(now())
  image       String
  heroId      String
  hero        Hero     @relation(fields: [heroId], references: [id])
}

model Item {
  id          String      @id @default(uuid())
  name        String
  description String
  image       String
  cost        Int
  cooldown    Float
}

model Emblem {
  id              String      @id @default(uuid())
  name            String
  description     String
  image           String
  emblemTalents   EmblemTalent[]
}

model EmblemTalent {
  id          String      @id @default(uuid())
  name        String
  description String
  image       String
  emblemId    String
  emblem      Emblem   @relation(fields: [emblemId], references: [id])
}

model Spell {
  id          String      @id @default(uuid())
  name        String
  description String
  image       String
  cooldown    Float
}

model GameMode {
  id          String      @id @default(uuid())
  name        String
  description String
}

model Rank {
  id          String      @id @default(uuid())
  name        String
  description String
  image       String
}


// Tables
// Heroes, Skins, Items, Emblems, Spells, Game Modes, Ranks 
